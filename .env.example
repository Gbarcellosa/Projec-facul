# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env real!

# ===== BANCO DE DADOS POSTGRESQL =====
# Railway, Supabase, Neon, local, etc.
DB_URL=jdbc:postgresql://localhost:5432/ecodenuncia
DB_USER=postgres
DB_PASSWORD=sua_senha_forte_aqui

# Para docker-compose (variáveis do Postgres)
POSTGRES_DB=ecodenuncia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_forte_aqui

# ===== CORS =====
# Origens permitidas (separadas por vírgula)
# Em produção, NÃO use *. Liste domínios específicos.
# Ex: CORS_ORIGINS=https://seuapp.com,https://www.seuapp.com
CORS_ORIGINS=*

# ===== SERVIDOR =====
PORT=8080

# ===== JPA/HIBERNATE =====
# DDL auto: 'update' para dev, 'validate' para produção
# Em produção, defina: SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_HIBERNATE_DDL_AUTO=update